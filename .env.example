# --- Database -------------------------------------------------------------
# Local dev uses SQLite. For Postgres/Supabase use e.g.
# DATABASE_URL=postgresql+psycopg://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./quotes.db
SEED_DEMO_DATA=true

# --- AI extraction ----------------------------------------------------------
# EXTRACTOR: auto (OpenAI if a key is set, else offline heuristic) | openai | heuristic
EXTRACTOR=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MATCH_CONFIDENCE_THRESHOLD=0.80
MIN_MATCH_SCORE=0.50

# --- Inventory / lead time -------------------------------------------------
# Leave empty to read stock from the local database. When set, the service calls
# GET {INVENTORY_API_URL}/availability?sku=...&quantity=...  ->  {"on_hand": 12, "lead_time_days": 5}
INVENTORY_API_URL=
INVENTORY_API_KEY=

# --- Outbound mail -----------------------------------------------------------
# MAIL_PROVIDER: console (writes .eml files to OUTBOX_DIR) | gmail | graph
MAIL_PROVIDER=console
OUTBOX_DIR=./outbox
MAIL_SENDER=sales@example.com

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Approval notifications ------------------------------------------------
# Either let n8n notify the salesperson (recommended), or have the API email them directly.
N8N_QUOTE_READY_WEBHOOK_URL=
SALES_NOTIFY_EMAIL=

# --- Security ---------------------------------------------------------------
INBOUND_WEBHOOK_SECRET=change-me-inbound
APPROVER_API_TOKEN=change-me-approver
ENABLE_DEV_ENDPOINTS=true

# --- Quote defaults ---------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
QUOTES_DIR=./quote_pdfs
COMPANY_NAME=Acme Industrial Supply
COMPANY_ADDRESS=100 Example Street\nSpringfield, CA 90000
COMPANY_EMAIL=sales@example.com
CURRENCY=USD
QUOTE_VALIDITY_DAYS=30
DEFAULT_TAX_RATE=0
SHIPPING_RATE_PER_KG=1.50
FREE_SHIPPING_THRESHOLD=2500
MIN_SHIPPING_CHARGE=15

# --- Email understanding (v2) ------------------------------------------------------
# Your own company's email domain(s), comma-separated, e.g. yourcompany.com
# Emails FROM these domains are treated as forwarded by a colleague: the quote goes to the original
# customer found in the forwarded message, and the colleague is copied.
INTERNAL_EMAIL_DOMAINS=
MAX_ATTACHMENT_MB=15

# --- Shipping cost API (v2) ----------------------------------------------------------
# Leave empty to use SHIPPING_RATE_PER_KG / FREE_SHIPPING_THRESHOLD / MIN_SHIPPING_CHARGE above.
# When set, the app calls POST {SHIPPING_API_URL}/rates and expects {"amount": 42.5, "service": "Ground", "transit_days": 3}
SHIPPING_API_URL=
SHIPPING_API_KEY=

# --- Who sends approved quotes (v2) ------------------------------------------------
# backend = this app sends them (MAIL_PROVIDER above) | n8n = n8n sends them (import n8n workflow 3a or 3b)
SEND_MODE=backend
N8N_QUOTE_APPROVED_WEBHOOK_URL=

# --- Approval web app (v2) -----------------------------------------------------------
# Only needed if you run the Next.js dev server (npm run dev) on a different port.
CORS_ORIGINS=http://localhost:3000

# --- Sample data ---------------------------------------------------------------
# Quotes for the built-in sample customers are never emailed through Gmail, Outlook or n8n unless this is true.
ALLOW_SAMPLE_SENDS=false

# --- Guardrails -------------------------------------------------------------------
# Lines are flagged for review when a quantity is at least this large, or this many times
# the customer usual quantity on their sent quotes.
LARGE_QUANTITY_THRESHOLD=1000
UNUSUAL_QUANTITY_FACTOR=5
