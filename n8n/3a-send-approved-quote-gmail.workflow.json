          "timeout": 180000
        }
      },
      "id": "78c38a8b-cdcf-5f26-9c6a-52ee054c09c0",
      "name": "Claim quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Turn the PDF from the claim response into an n8n binary file called \"data\".\nconst out = [];\nfor (const item of $input.all()) {\n  const { attachment_base64, ...quote } = item.json;\n  const pdf = await this.helpers.prepareBinaryData(\n    Buffer.from(attachment_base64, 'base64'), quote.attachment_filename, quote.attachment_mime_type);\n  out.push({ json: quote, binary: { data: pdf } });\n}\nreturn out;"
      },
      "id": "d4b3be0b-4255-5700-80a5-71fa3e014946",
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c2f59f80-625b-577f-a5c4-7dc005598ff1",
              "leftValue": "={{ $json.reply_to_provider_message_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fb171745-bf56-5e48-8ac0-4c3fb4242960",
      "name": "Reply in customer thread?",
