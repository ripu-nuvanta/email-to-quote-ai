      "name": "Quote approved",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "703d332a-2ecb-5375-a27c-f197c67fbccb"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.QUOTE_API_URL }}/api/integrations/quotes/{{ $json.body.quote_id }}/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
